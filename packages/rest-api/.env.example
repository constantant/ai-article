DATABASE_URL="file:./dev.db"

# Shared secret required in the x-admin-key header to register new apps (POST /apps).
ADMIN_API_KEY="dev-admin-key"

# Shared secret required in the x-service-key header for mcp-server's
# service-to-service user endpoints. Must match mcp-server's MCP_SERVICE_KEY.
MCP_SERVICE_KEY="dev-service-key"
